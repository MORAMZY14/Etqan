platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :dynamic
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  pod 'FirebaseCore', '11.10.0'
  pod 'FirebaseAuth', '11.10.0'
  pod 'FirebaseFirestore', '11.10.0'
  pod 'FirebaseStorage', '11.10.0'
  pod 'FirebaseFunctions', '11.10.0'
  pod 'FirebaseSharedSwift', '11.10.0'
  pod 'GTMSessionFetcher/Core', '3.4.0'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['SWIFT_VERSION'] = '5.9'
      config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'YES'
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
    end
  end

  installer.pods_project.build_configurations.each do |config|
    config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone'
  end

  # 🚑 Final fix: remove missing privacy bundle refs
  installer.pods_project.targets.each do |target|
    next unless target.respond_to?(:resources_build_phase) && target.resources_build_phase

    target.resources_build_phase.files.each do |file|
      if file.respond_to?(:file_ref) && file.file_ref
        path = file.file_ref.real_path.to_s
        if path =~ /_privacy(\.bundle)?$/ && !File.exist?(path)
          puts "⚠️ Removing missing privacy bundle reference: #{path}"
          target.resources_build_phase.remove_file_reference(file.file_ref)
        end
      end
    end
  end
end
